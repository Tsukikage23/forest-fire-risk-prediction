# FireGuard Environment Configuration Template
# Duplicate this file to .env and provide your values. Never commit credentials to version control.

# Backend Configuration
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/forest_fire_db
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ML_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend (for Vite client-side build)
VITE_API_URL=http://localhost:5001/api

# Optional AWS Integrations (leave blank for local development)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SNS_TOPIC_ARN=
SNS_RISK_THRESHOLD=0.7
REPORT_BUCKET=
